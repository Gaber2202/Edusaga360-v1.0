# Server
PORT=3001
FRONTEND_URL=http://localhost:5173
PARENT_PORTAL_URL=https://edusaga-360-parent-portal.vercel.app

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# SMTP (for notifications)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Yamen AI — LLM provider
# Providers are auto-detected in priority order: Gemini → Claude → Groq → OpenAI.
# All four support full tool use (live school-data queries). Set ONE key, or pin
# one explicitly with AI_PROVIDER below.
#
# If a key IS set but chat still fails, the key works but the call is failing
# (region/key/model/quota). Hit GET /api/ai/diagnostics for the real cause.
#
# Recommended free, region-safe option: Groq (https://console.groq.com).
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Google Gemini (free tier; can be region-restricted on some hosts)
GOOGLE_AI_API_KEY=
GOOGLE_AI_MODEL=gemini-2.0-flash

# Anthropic Claude
ANTHROPIC_API_KEY=

# OpenAI, or any OpenAI-compatible provider (OpenRouter, Together, DeepSeek …)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1   # override for OpenAI-compatible hosts

# Optional: pin the provider regardless of which keys exist.
# One of: gemini | claude | groq | openai
AI_PROVIDER=

# File Storage (Cloudflare R2)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=edusaga-360

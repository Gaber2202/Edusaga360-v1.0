# Server
PORT=3001
FRONTEND_URL=http://localhost:5173
PARENT_PORTAL_URL=https://edusaga-360-parent-portal.vercel.app

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# SMTP (for notifications)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Yamen AI — LLM provider (Gemini is primary)
# If GOOGLE_AI_API_KEY is set but chat still fails, the key works but the call is
# failing (region/key/model/quota). Hit GET /api/ai/diagnostics to see the real
# cause, and set a fallback key below (ANTHROPIC/OPENAI/GROQ) — all are wired in.
GOOGLE_AI_API_KEY=
GOOGLE_AI_MODEL=gemini-2.0-flash
# Fallbacks (optional, used in this order if Gemini fails):
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GROQ_API_KEY=

# File Storage (Cloudflare R2)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=edusaga-360

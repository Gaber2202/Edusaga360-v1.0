# Server
PORT=3001
FRONTEND_URL=http://localhost:5173
PARENT_PORTAL_URL=https://edusaga-360-parent-portal.vercel.app

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# SMTP (for notifications)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Transactional email (Infobip) — powers invitations and password-reset emails.
# When unset, admin-initiated reset still returns a copyable link, and
# self-service reset falls back to Supabase's built-in recovery email
# (which requires SMTP configured in your Supabase project).
INFOBIP_API_KEY=
INFOBIP_BASE_URL=
INFOBIP_SENDER_EMAIL=noreply@edusaga360.com

# Yamen AI — LLM provider
# Providers are auto-detected in priority order: Gemini → Claude → Groq → OpenAI.
# All four support full tool use (live school-data queries). Set ONE key, or pin
# one explicitly with AI_PROVIDER below.
#
# If a key IS set but chat still fails, the key works but the call is failing
# (region/key/model/quota). Hit GET /api/ai/diagnostics for the real cause.
#
# Recommended free, region-safe option: Groq (https://console.groq.com).
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Google Gemini (free tier; can be region-restricted on some hosts)
GOOGLE_AI_API_KEY=
GOOGLE_AI_MODEL=gemini-2.0-flash

# Anthropic Claude
ANTHROPIC_API_KEY=

# OpenAI, or any OpenAI-compatible provider (OpenRouter, Together, DeepSeek …)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1   # override for OpenAI-compatible hosts

# Optional: pin the provider regardless of which keys exist.
# One of the built-ins (gemini | claude | groq | openai) OR a custom provider
# name declared in AI_CUSTOM_PROVIDERS below.
AI_PROVIDER=

# Optional: explicit failover chain (comma-separated), used when AI_PROVIDER is
# not pinned. e.g. AI_PROVIDER_ORDER=ksa-local,openai,groq
AI_PROVIDER_ORDER=

# ── Custom / local / regional LLMs ────────────────────────────────────────────
# Add ANY number of OpenAI-compatible endpoints as a JSON array — no code change
# needed. This is how a deployment points Yamen at a local or in-country model
# (e.g. a KSA-hosted LLM, vLLM, Ollama, Azure OpenAI, OpenRouter, Together …).
#   - base_url + model are required.
#   - api_key_env names the env var holding the key; omit it for keyless local
#     endpoints. (You can also inline a key with "api_key", but env is safer.)
#   - format defaults to "openai"; use "gemini" or "anthropic" for those wire
#     protocols.
# Example (a KSA-hosted model, then reference its key below):
#   AI_CUSTOM_PROVIDERS=[{"name":"ksa-local","base_url":"https://llm.example.sa/v1","model":"jais-30b","api_key_env":"KSA_LLM_KEY"}]
#   KSA_LLM_KEY=...
# Keyless on-prem example:
#   AI_CUSTOM_PROVIDERS=[{"name":"onprem","base_url":"http://127.0.0.1:11434/v1","model":"llama3"}]
AI_CUSTOM_PROVIDERS=

# File Storage (Cloudflare R2)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=edusaga-360
